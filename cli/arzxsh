#!/usr/bin/env bash
# arzxsh CLI launcher (repo layout). The installed package ships
# the same entry as /usr/bin/arzxsh pointing at /usr/share/arzxsh.
# First run creates a per-user venv for the Python libraries
# (textual, httpx, Pillow); the backend has its own venv, created
# by the app itself on first use. Requires: python3, mpv.
set -e
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
VENV="$HERE/.venv"
if [ ! -x "$VENV/bin/python" ]; then
  echo "arzxsh: first run, creating the CLI environment…"
  python3 -m venv "$VENV"
  "$VENV/bin/pip" install -q -r "$HERE/requirements.txt"
fi
export PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}"
exec "$VENV/bin/python" -m arzxsh_cli.main "$@"
