<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- No RECORD_AUDIO (0.6.7): the visualizer bars are driven by
         playback state and position, never by audio capture, so the
         app needs no microphone permission at all. Play Protect
         flagged the old audiofx-Visualizer permission as a
         microphone in a music player; it is gone for good. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Background playback (0.6.1): the media notification is the
         foreground service's face. Requested at runtime on first
         play; if denied, playback continues and the system simply
         hides the notification. WAKE_LOCK pairs with ExoPlayer's
         WAKE_MODE_NETWORK so screen-off streaming does not stall. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Built-in equalizer (0.6.8): creating audio effects on the
         player's own audio session takes MODIFY_AUDIO_SETTINGS —
         a normal, auto-granted permission. It cannot record,
         listen, or touch any other app's audio. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- In-app updates (0.6.3): lets the system installer take an
         APK this app downloaded from its own GitHub releases. The
         per-app "allow installs from arzxsh" grant is still the
         user's to give in system Settings; installs are never
         silent. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:theme="@style/AppTheme"
        android:label="arzxsh"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Background playback service (0.6.1): media notification
             + media session; the mediaPlayback type is the
             Android 14 foreground-service requirement. Not
             exported: only this app starts it and sends it
             transport actions; media-button routing goes through
             the session itself. -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- Shares ONLY the downloaded update APK with the system
             installer (cache/updates via res/xml/file_paths).
             Not exported; grants are per-intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
