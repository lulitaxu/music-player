<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules (audit 2026-11-11): allowBackup=false is
     the substantive control; these rules make the same posture
     explicit for Android 12+ cloud backup and device transfer, so
     flipping allowBackup in the future cannot silently start
     exporting app data. Everything is excluded, in both modes. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
