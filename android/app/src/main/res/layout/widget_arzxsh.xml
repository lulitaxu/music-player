<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget layout (0.6.8). RemoteViews: kept flat
     and static on purpose — three text/image slots and three
     button images, nothing the launcher has to work to render. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="Album art"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="arzxsh"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tap to open"
            android:textColor="#A7A7A7"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_prev"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_widget_btn"
        android:padding="10dp"
        android:contentDescription="Previous"
        android:src="@drawable/ic_skip_prev" />

    <ImageButton
        android:id="@+id/widget_toggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_widget_btn"
        android:padding="11dp"
        android:contentDescription="Play or pause"
        android:src="@drawable/ic_play" />

    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_widget_btn"
        android:padding="10dp"
        android:contentDescription="Next"
        android:src="@drawable/ic_skip_next" />
</LinearLayout>
