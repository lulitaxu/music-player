# Signing is configured through ENVIRONMENT VARIABLES (canonical since
# 0.6.6). build.gradle.kts no longer reads keystore.properties; this file
# only documents the variables. Never commit a keystore or its password.
#
#   ANDROID_KEYSTORE_FILE     path to arzxsh-release.keystore
#   ANDROID_KEYSTORE_PASSWORD store password
#   ANDROID_KEY_ALIAS         arzxsh
#   ANDROID_KEY_PASSWORD      key password
#
# CI: the workflow decodes the ANDROID_KEYSTORE_BASE64 GitHub secret to a
# temp path and exports the four variables above from the matching
# secrets (ANDROID_KEYSTORE_PASSWORD / ANDROID_KEY_ALIAS /
# ANDROID_KEY_PASSWORD).
#
# Local: the real keystore and keystore.env live in keys/ at the repo
# root (gitignored). From this android/ directory:
#   set -a; . ../keys/keystore.env; set +a
#   export ANDROID_KEYSTORE_FILE="$PWD/../keys/arzxsh-release.keystore"
#   export ANDROID_KEYSTORE_PASSWORD="$KEYSTORE_PASSWORD"
#   export ANDROID_KEY_ALIAS="$KEY_ALIAS"
#   export ANDROID_KEY_PASSWORD="$KEY_PASSWORD"
#
# Without the variables, debug falls back to the default Android debug
# key (fine for throwaway local builds, but those builds can NOT update
# installs signed with the stable key, or vice versa).
